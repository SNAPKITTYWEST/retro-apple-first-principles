10 REM ============================================================
20 REM C64 MEMORY HAMMER -- RAM stress / pattern torture
30 REM SoftBASIC loader + 6502 worker
40 REM Patterns: walking 1/0, checkerboard, AA/55, random-ish LFSR
50 REM Safe zone: $C000-$CFFF (4K under BASIC ROM shadow free)
60 REM Optional full user-RAM sweep excluding this program
70 REM ============================================================
80 PRINT CHR$(147);"C64 MEMORY HAMMER"
90 PRINT "------------------"
100 PRINT "1 Quick 4K hammer ($C000-$CFFF)"
110 PRINT "2 Full user RAM (careful)"
120 PRINT "3 Install ML only + SYS"
130 PRINT "4 Quit"
140 INPUT "Choice";CH
150 IF CH=4 THEN END
160 IF CH=3 THEN GOSUB 1000: PRINT "ML at";SA: END
170 IF CH=1 THEN LO=49152:HI=53247:GOTO 200
180 IF CH=2 THEN LO=2048:HI=40959:GOTO 200
190 GOTO 80
200 GOSUB 1000
210 PRINT "Hammering";LO;"-";HI
220 PRINT "Passes: walking1, walking0, AA/55, checker, LFSR"
230 SYS SA,LO,HI
240 PRINT "DONE -- no bus error trapped (C64 has none)"
250 PRINT "If machine locked, RAM or PSU suspect."
260 END

1000 REM ---- load ML worker ----
1010 SA=49152
1020 CHK=0
1030 FOR I=0 TO 179: READ B: POKE SA+I,B: CHK=CHK+B: NEXT
1040 IF CHK<>19234 THEN PRINT "DATA ERROR";CHK: STOP
1050 RETURN

