20 REM NEW PROOFREADER + OPTIONAL OPTIMIZED CHECKSUM CORE
30 REM Standard Nelson loader, then optional replace of handler
40 REM ============================================================
50 VEC=PEEK(772)+256*PEEK(773):LO=43:HI=44
60 PRINT"{CLR}{WHT}PROOFREADER + OPT FOR ";
70 IF VEC=42364 THEN PRINT "C-64"
80 IF VEC=17165 THEN LO=45:HI=46:PRINT "128"
90 SA=(PEEK(LO)+256*PEEK(HI))+6:ADR=SA
100 FOR J=0 TO 166:READ BYT:POKE ADR,BYT:ADR=ADR+1:CHK=CHK+BYT:NEXT
110 IF CHK<>20570 THEN PRINT "DATA ERROR (base)":END
120 FOR J=1 TO 5:READ RF,LF,HF:RS=SA+RF:HB=INT(RS/256):LB=RS-(256*HB)
130 CHK=CHK+RF+LF+HF:POKE SA+LF,LB:POKE SA+HF,HB:NEXT
140 IF CHK<>22054 THEN PRINT "FIXUP ERROR":END
150 POKE SA+149,PEEK(772):POKE SA+150,PEEK(773)
160 PRINT "BASE PROOFREADER LOADED AT";SA
170 INPUT "INSTALL SPEED-OPT CORE AT $C100 (Y/N)";A$
180 IF A$<>"Y" AND A$<>"y" THEN 220
190 GOSUB 500
200 REM point ICRNCH at opt core (after its own tiny install stub)
